{
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "./dist",

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}